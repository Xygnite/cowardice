extends SceneTree
## Dumps a character's rig parts (assets/sprites/<name>/*.png) as art/pxl/<name>_parts.px.js: a pxl palette
## (PAL), every part as a full-canvas grid (PARTS) and its RIGS entry from tools/rig_sprites.gd (RIG, points
## as [x, y]), which art/pxl/<name>.px.js animates through art/pxl/lib.px.js. Re-run after the rig is re-cut.
## Run: godot --headless --path . -s tools/pxl_parts.gd -- <name>

const KEYS := "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!$%&*+-=?@^~<>"
const ORDER := ["legs", "body", "weapon", "shield", "head", "chest", "lantern", "glow"]  # then skirt_*
const SWAY_STEPS := 5  # lantern and glow are saved as sway frames side by side; the middle one hangs straight


func _init() -> void:
	var name: String = OS.get_cmdline_user_args()[0]
	var rig: Dictionary = load("res://tools/rig_sprites.gd").get_script_constant_map().RIGS[name]
	var dir := "res://assets/sprites/%s/" % name
	var parts: Array = ORDER.filter(func(p): return FileAccess.file_exists(dir + p + ".png"))
	for i in rig.get("skirt", []).size():
		parts.append("skirt_%d" % i)
	var keys := {}
	var grids: PackedStringArray = []
	for p in parts:
		var img := Image.load_from_file(ProjectSettings.globalize_path(dir + p + ".png"))
		img.convert(Image.FORMAT_RGBA8)
		var w := img.get_width()
		var x0 := 0
		if p in ["lantern", "glow"]:
			w /= SWAY_STEPS
			x0 = w * (SWAY_STEPS / 2)
		var rows: PackedStringArray = []
		for y in img.get_height():
			var row := ""
			for x in w:
				var c := img.get_pixel(x0 + x, y)
				if c.a == 0.0:
					row += "."
					continue
				var hex := c.to_html(false)
				if not keys.has(hex):
					keys[hex] = KEYS[keys.size()]
				row += keys[hex]
			rows.append(row)
		grids.append('  %s: `\n%s`' % [p, "\n".join(rows)])
	var js: PackedStringArray = [
		"// Generated by tools/pxl_parts.gd from assets/sprites/%s/*.png and its RIGS entry; don't edit." % name,
		"const PAL = { " + ", ".join(keys.keys().map(func(h): return '"%s": "#%s"' % [keys[h], h])) + " }",
		"pal(PAL)",
		"const PARTS = {\n%s\n}" % ",\n".join(grids),
		"const RIG = " + JSON.stringify(_plain(rig)),
	]
	FileAccess.open("res://art/pxl/%s_parts.px.js" % name, FileAccess.WRITE).store_string("\n".join(js) + "\n")
	print("%s: %d colours, parts %s" % [name, keys.size(), ", ".join(parts)])
	quit()


## Vector2 -> [x, y], recursively; outlines and colours dropped (the parts already hold what they claimed).
func _plain(v: Variant) -> Variant:
	if v is Vector2:
		return [v.x, v.y]
	if v is Array:
		return v.map(_plain)
	if v is Dictionary:
		var out := {}
		for k in v:
			if k not in ["outline", "glow", "patch", "skirt"]:
				out[k] = _plain(v[k])
		return out
	return v
